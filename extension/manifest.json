{
  "manifest_version": 3,
  "name": "Proton → Personal Mail MCP",
  "version": "0.4.4",
  "description": "从当前 Proton 浏览器会话恢复 Session 与派生解密材料，确认后导入 Personal Mail MCP。",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://proton.me/*",
    "https://mail.proton.me/*",
    "https://account.proton.me/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接 Personal Mail MCP"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
