{
  "manifest_version": 3,
  "name": "Proton → Mail MCP Worker",
  "version": "0.4.5",
  "description": "从已登录 Proton 浏览器会话恢复 Session 与派生解密材料，经确认导入自己部署的 Mail MCP Worker。",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://proton.me/*",
    "https://mail.proton.me/*",
    "https://account.proton.me/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接 Mail MCP Worker"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
